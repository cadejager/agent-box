FROM agent-base

# Add the claude-desktop-debian apt repo and install Claude Desktop, plus
# Electron's GUI runtime libraries. The .deb under-declares its Chromium/GTK
# runtime deps and the node:trixie base is minimal, so we install them
# explicitly: these are the sonames that came up "not found" via ldd on the
# Electron binary, plus libgbm1 for GPU rendering and a base font so text
# renders. gnupg is needed to dearmor the repo signing key; libgl1-mesa-dri
# is the DRI driver for GPU-accelerated rendering via /dev/dri.
#
# Note: we deliberately do NOT install bubblewrap or qemu. Without them,
# Claude Desktop's "Cowork" feature auto-selects its host backend (no inner
# sandbox) rather than trying to nest a bubblewrap/KVM sandbox inside this
# container. The launcher also forces COWORK_VM_BACKEND=host at runtime.
RUN apt-get update \
 && apt-get install -y --no-install-recommends gnupg libgl1-mesa-dri \
 && curl -fsSL https://pkg.claude-desktop-debian.dev/KEY.gpg \
      | gpg --dearmor -o /usr/share/keyrings/claude-desktop.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/claude-desktop.gpg arch=amd64,arm64] https://pkg.claude-desktop-debian.dev stable main" \
      > /etc/apt/sources.list.d/claude-desktop.list \
 && apt-get update \
 && apt-get install -y claude-desktop \
      libnss3 libnspr4 \
      libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 \
      libcups2t64 libdbus-1-3 libgtk-3-0t64 \
      libxcomposite1 libxdamage1 libxfixes3 libxrandr2 \
      libxkbcommon0 libasound2t64 \
      libgbm1 libxshmfence1 \
      fonts-liberation

WORKDIR /app
