FROM agent-base

# Install claude-code
RUN npm install -g @anthropic-ai/claude-code

# Pre-create the config file so the launcher's ~/.claude.json bind has a FILE
# destination. Under Charliecloud (--write-fake) a missing bind destination is
# auto-created as a directory, which makes a single-file bind fail.
RUN touch /root/.claude.json

WORKDIR /app
