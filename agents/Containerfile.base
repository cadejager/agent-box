FROM node:trixie

# Install software (single layer; fail fast on update errors, skip recommended
# packages, and drop the apt lists afterward to keep the image smaller). This
# toolchain is inherited by every agent image built FROM agent-base.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ansible bubblewrap curl git python3 pip gcc g++ gdb valgrind cmake rust-all \
 && rm -rf /var/lib/apt/lists/*

# certs
COPY certs/ /usr/local/share/ca-certificates/
RUN update-ca-certificates
